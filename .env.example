# ─────────────────────────────────────────────────────────────────────────────
# Outreach AI — environment
#
# Almost nothing belongs here. Per-person settings (AI provider, API keys,
# mailboxes) are configured in the app itself at http://127.0.0.1:3000/setup and
# stored in the local database.
#
# Any setting below can also be supplied as an env var, which wins over the
# value stored in the app. That is an escape hatch for whoever prefers it —
# teammates should not need to touch this file at all.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google OAuth (REQUIRED for the email channel) ────────────────────────────
# One "Desktop app" OAuth client, created once for the whole team in Google
# Cloud Console, with the consent screen set to user type = Internal so only
# geonode.com accounts can consent. Desktop client secrets are not true secrets
# (Google's docs treat them as such), so these ship with the repo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Server ───────────────────────────────────────────────────────────────────
# The server always binds to 127.0.0.1. Change the port only if 3000 is taken;
# if you do, update the redirect URI on the Google OAuth client to match.
PORT=3000

# ── Optional overrides (normally set in the app, not here) ───────────────────
# AI provider: ollama | openai-compatible | anthropic
# LLM_PROVIDER=
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# HEYREACH_API_KEY=
# HEYREACH_CAMPAIGN_ID=
# HEYREACH_LINKEDIN_ACCOUNT_ID=
# HEYREACH_API_BASE_URL=

# TELEGRAM_BOT_TOKEN=
